{
 "standard_id": "CO_RAS_0330_2017_COMP2021",
 "rules": [
  {
   "type": "WALL_SHEAR_MIN",
   "param": "min_wall_shear_stress",
   "cond": {
    "system": "separate"
   },
   "flows": [
    "initial",
    "design"
   ],
   "resolution": "Art.141 τ≥1.0 Pa, 계획기간 초기·말기 모두 (실수심)"
  },
  {
   "type": "VELOCITY_MAX",
   "param": "max_velocity",
   "cond": {
    "system": "separate"
   },
   "state": "actual",
   "enforce": "hard"
  },
  {
   "type": "CAPACITY",
   "kind": "depth_ratio",
   "param": "max_depth_ratio",
   "cond": {
    "system": "separate"
   }
  },
  {
   "type": "MIN_DIAMETER",
   "param": "min_pipe_diameter",
   "cond": {
    "system": "separate"
   }
  },
  {
   "type": "MIN_COVER",
   "kind": "value",
   "param": "min_cover",
   "cond": {
    "system": "separate"
   },
   "cond_from_project": {
    "location": "street_location"
   },
   "allow": [
    "location",
    "other"
   ],
   "clause": "Art.139 Tabla 18"
  },
  {
   "type": "JUNCTION",
   "kind": "crown",
   "min_drop_param": "junction_drop_min",
   "min_drop_when": "loss_le_zero",
   "clause": "Art.137",
   "resolution": "국부손실 ≤0일 때 관정 간 최소 0.02 m — 손실 계산 미구현으로 합류 맨홀엔 항상 적용, 같은 관경 직선 통과 맨홀은 손실 > 0이라 미적용"
  },
  {
   "type": "MANHOLE_SPACING",
   "param": "manhole_max_spacing",
   "receives_house_connections": true
  },
  {
   "type": "DESIGN_FLOW",
   "per_capita": {
    "kind": "product",
    "factors": [
     {
      "param": "per_capita_water_net",
      "ctx_from_project": {
       "altitude_masl": "altitude_masl"
      },
      "allow": [
       "altitude_masl",
       "other"
      ]
     },
     {
      "param": "return_coefficient",
      "cond": {
       "wastewater_type": "domestic"
      },
      "allow": [
       "wastewater_type",
       "exception"
      ]
     }
    ],
    "clause": "Art.43 Tabla 1 × Art.134 num.1 CR"
   },
   "infiltration": {
    "kind": "excluded",
    "text": "Art.134 num.5·6 침입수 0.1 L/s·ha(도로 면적), 오접 0.2 L/s·ha — 관망 면적 입력 없음"
   },
   "peak": {
    "kind": "range_clamp_project",
    "param": "peak_factor_hourly",
    "key": "peak_formula",
    "clause": "Art.134 num.4 (1.4~3.8)"
   },
   "floor": {
    "param": "min_design_flow",
    "cond": {
     "system": "separate"
    },
    "clause": "Art.134 num.7 구간 최소 1.5 L/s"
   }
  },
  {
   "type": "PUMP_TRIGGER",
   "kind": "none",
   "text": "설치 조건 규정 없음(Art.160-2 인라인 양수 허용 조건만)"
  },
  {
   "type": "FORCE_MAIN_VELOCITY",
   "min_param": "force_main_min_velocity",
   "max_param": "force_main_max_velocity",
   "cond": {
    "pipe_role": "force_main"
   },
   "allow": [
    "pipe_role",
    "other"
   ],
   "flow": "design_pumping_rate"
  },
  {
   "type": "FORCE_MAIN_FRICTION",
   "kind": "project",
   "key": "hazen_c",
   "text": "RAS 하수 조항에 마찰식·C 없음"
  },
  {
   "type": "PUMP_COUNT",
   "param": "pump_count_rule",
   "cond": {},
   "allow": [
    "other"
   ],
   "kind": "firm_capacity",
   "min": 2,
   "text": "Art.161-1 가동 1 + 휴지 1"
  },
  {
   "type": "WET_WELL_VOLUME",
   "kind": "multiple_of_pumping_rate",
   "param": "wet_well_volume_or_detention",
   "cond": {
    "system": "separate"
   },
   "retention_param": "wet_well_retention_max",
   "clause": "Art.160-7·8"
  },
  {
   "type": "PUMP_HEAD_POWER",
   "efficiency": "project",
   "clause": "Art.161-6 효율 하한 50/65/70%(동력 구간별) — 사업값"
  },
  {
   "type": "WET_WELL_LEVEL",
   "kind": "review",
   "text": "수위는 자동운전 기준만(Art.161-9), 수치 없음"
  },
  {
   "type": "MINOR_LOSS",
   "kind": "review",
   "text": "하수 조항에 전양정 구성 없음"
  },
  {
   "type": "SUCTION_PIPE",
   "kind": "velocity_range",
   "param": "pump_suction_velocity",
   "cond": {
    "other": {
     "pump_type": "centrifugal"
    },
    "system": "separate"
   },
   "allow": [
    "other"
   ],
   "clause": "Art.161-2"
  },
  {
   "type": "PUMP_SUBMERGENCE_NPSH",
   "kind": "submergence_ratio",
   "param": "pump_submergence_min",
   "cond": {
    "other": {
     "pump_type": "centrifugal"
    }
   },
   "allow": [
    "other"
   ],
   "npsh_param": "pump_npsh_margin",
   "npsh": "Art.161-4 NPSHd > NPSHr + 0.5 m — 펌프 NPSHr 입력 필요",
   "npsh_cond": {
    "other": {
     "pump_type": "centrifugal"
    }
   },
   "text": "Art.161-7 잠김 ≥ 2.5 × 흡입관경(원심펌프)"
  },
  {
   "type": "HOUSE_CONNECTION",
   "kind": "crown",
   "param": "house_connection",
   "allow": [
    "item",
    "pipe_role",
    "other"
   ],
   "dia_cond": {
    "item": "최소 실내경",
    "system": "separate"
   },
   "slope_cond": {
    "item": "최소 경사",
    "system": "separate"
   },
   "clause": "Art.144-3 관정 이상"
  },
  {
   "type": "DROP_STRUCTURE",
   "param": "drop_manhole_threshold",
   "boundary": "gt",
   "clause": "Artículo 155 numeral 1",
   "max": {
    "param": "max_drop_per_manhole",
    "action": "에너지 감쇠 구조 설계"
   },
   "pipe": {
    "kind": "table",
    "param": "drop_pipe_diameter",
    "dia": "inner",
    "scale_mm": 1000,
    "no_value_action": "낙하관 대신 에너지 저감 전이구조 설계"
   },
   "resolution": "Tabla 20 부등호는 300<D≤450, 450<D≤900 뜻으로 읽음",
   "allow": [
    "joint_method",
    "exception",
    "other"
   ]
  },
  {
   "type": "PLANT_FLOW",
   "flows": {
    "average": {
     "kind": "sewer_no_peak",
     "clause": "Art.134 건기 일평균(침입수·오접합 제외)"
    },
    "max_daily": {
     "kind": "factor_table",
     "of": "average",
     "param": "plant_peak_factor_daily"
    },
    "peak_hourly": {
     "kind": "factor_table",
     "of": "average",
     "param": "plant_peak_factor_hourly"
    },
    "max_monthly": {
     "kind": "factor_table",
     "of": "average",
     "param": "plant_peak_factor_monthly"
    }
   },
   "small_plant": {
    "max_lps": 30,
    "param": "plant_design_flow_basis",
    "cond": {
     "flow_basis": "dry_weather_average"
    },
    "allow": [
     "exception"
    ],
    "clause": "Art.166 30 L/s 이하: 설계유량 = 건기 일평균 × 3 (모든 단위)"
   },
   "resolution": "Art.166 Tabla 23 첨두계수는 평균유량 10·90·700 L/s 사이 선형보간(원문 지시). 30 L/s 초과 시 침입수 0.1 L/s·ha는 관망 면적 입력 없어 제외"
  },
  {
   "type": "INFLUENT_LOAD",
   "bod": {
    "param": "influent_bod_per_capita",
    "cond": {
     "wastewater_type": "domestic",
     "value_type": "suggested"
    },
    "allow": [
     "wastewater_type"
    ]
   },
   "ss": {
    "param": "influent_ss_per_capita",
    "cond": {
     "wastewater_type": "domestic",
     "value_type": "suggested"
    },
    "allow": [
     "wastewater_type"
    ]
   },
   "concentration_flow": "average",
   "resolution": "Art.169 Tabla 24 권장값(Valor sugerido). 범위(25~80 등)는 기준선 정의라 설계값으로 쓰지 않음"
  },
  {
   "type": "PRIMARY_CLARIFIER",
   "loading": [
    {
     "param": "primary_surface_loading",
     "cond": {
      "flow_basis": "average_daily"
     },
     "flow": "average"
    },
    {
     "param": "primary_surface_loading",
     "cond": {
      "flow_basis": "peak"
     },
     "flow": "peak_hourly"
    }
   ],
   "time": [
    {
     "param": "primary_detention_time",
     "flow": "peak_hourly"
    }
   ],
   "depth": {
    "param": "primary_side_water_depth"
   },
   "count": [
    {
     "param": "primary_tank_count_min",
     "when": "average_lps >= 100"
    }
   ],
   "bod_removal": {
    "param": "primary_bod_removal",
    "design": "min"
   },
   "ss_removal": {
    "param": "primary_ss_removal",
    "design": "min"
   },
   "resolution": "Art.189: 평균·첨두 두 조건으로 면적을 구해 큰 쪽(의무). 체류시간은 시간최대 설계유량(Art.189 3호). Tabla 29 최소 효율 범위의 하한을 설계 제거율로"
  },
  {
   "type": "AERATION_TANK",
   "flow": "max_monthly",
   "hrt": {
    "param": "asp_hrt",
    "cond": {
     "process": "conventional_asp"
    }
   },
   "fm": {
    "param": "asp_fm_ratio",
    "cond": {
     "process": "conventional_asp",
     "climate": "tropical_colombia"
    },
    "basis": "mlvss"
   },
   "lv": {
    "param": "asp_volumetric_bod_loading",
    "cond": {
     "process": "conventional_asp",
     "climate": "tropical_colombia"
    }
   },
   "mlvss": {
    "param": "asp_mlvss",
    "cond": {
     "process": "conventional_asp"
    },
    "design": "mid"
   },
   "srt": {
    "param": "asp_srt",
    "cond": {
     "process": "conventional_asp"
    },
    "design": "mid"
   },
   "bod_removal": {
    "param": "asp_bod_removal",
    "cond": {
     "process": "conventional_asp"
    },
    "design": "min"
   },
   "ss_removal": {
    "param": "asp_ss_removal",
    "cond": {
     "process": "conventional_asp"
    },
    "design": "min"
   },
   "resolution": "Tabla 36 Convencional, 열대 조건 F/M·Lv 최고값(의무). 반응조는 월최대유량(Tabla 22). MLVSS 단위 미표기 → mg/L. 반송비 수치 없음"
  },
  {
   "type": "SECONDARY_CLARIFIER",
   "loading": [
    {
     "param": "secondary_surface_loading",
     "cond": {
      "flow_basis": "average_daily"
     },
     "flow": "average"
    },
    {
     "param": "secondary_surface_loading",
     "cond": {
      "flow_basis": "peak"
     },
     "flow": "peak_hourly"
    }
   ],
   "time": [
    {
     "param": "secondary_detention_time",
     "flow": "peak_hourly"
    }
   ],
   "depth": {
    "param": "secondary_side_water_depth"
   },
   "count": [
    {
     "param": "secondary_tank_count_min",
     "when": "average_lps >= 250"
    }
   ],
   "resolution": "Art.195 평균·첨두 두 조건 중 큰 면적, 체류시간은 시간최대. 고형물부하 수치 없음"
  },
  {
   "type": "EFFLUENT_LIMIT",
   "country": "CO",
   "match_contains": {
    "discharger": "prestadores"
   },
   "params": {
    "bod": "^DBO5",
    "ss": "^SST"
   },
   "capacity": {
    "key": "load_kg_d_DBO5",
    "from": "bod_load_kg_d"
   },
   "resolution": "Res. 0631/2015 Art.8 하수도 사업자 생활하수, 유입 BOD5 부하(kg/d) 구간"
  }
 ],
 "pipe": {
  "nominal": "as_is",
  "min_dia_compare": "inner",
  "table_lookup": "nominal"
 }
}