{
 "standard_id": "CPHEEO_SEW_2013",
 "rules": [
  {
   "type": "VELOCITY_MIN",
   "param": "min_velocity",
   "cond": {
    "system": "separate"
   },
   "basis": {
    "horizon": "initial"
   },
   "flow": "initial",
   "state": "actual",
   "resolution": "Table 3.9 + 3.15.5·부록 A 3.4(Table 3.12 비율로 실수심 유속)"
  },
  {
   "type": "VELOCITY_MIN",
   "param": "min_velocity",
   "cond": {
    "system": "separate"
   },
   "basis": {
    "horizon": "ultimate"
   },
   "flow": "design",
   "state": "actual",
   "resolution": "Table 3.9 + 3.15.5·부록 A 3.4"
  },
  {
   "type": "VELOCITY_MAX",
   "param": "max_velocity",
   "cond": {
    "system": "separate"
   },
   "state": "actual",
   "enforce": "hard"
  },
  {
   "type": "SLOPE_TABLE",
   "param": "min_slope",
   "cond": {
    "system": "separate"
   }
  },
  {
   "type": "CAPACITY",
   "kind": "depth_ratio",
   "param": "max_depth_ratio",
   "cond": {
    "shape": "circular"
   }
  },
  {
   "type": "MIN_DIAMETER",
   "param": "min_pipe_diameter",
   "cond": {
    "system": "separate",
    "shape": "circular"
   },
   "allow": [
    "other"
   ]
  },
  {
   "type": "MIN_COVER",
   "kind": "project",
   "key": "cover",
   "clause": "3.20.3 (시점부 1 m 참고값)"
  },
  {
   "type": "JUNCTION",
   "kind": "crown",
   "clause": "3.17.1"
  },
  {
   "type": "MANHOLE_SPACING",
   "param": "manhole_max_spacing",
   "receives_house_connections": true
  },
  {
   "type": "NO_DECREASE",
   "enforce": "hard",
   "clause": "3.17.1",
   "text": "Transition from larger to smaller diameters shall not be made",
   "rationale": "CPHEEO 3.17.1: 관정 연속 유지(The crowns of sewers are always kept continuous), 역류 방지"
  },
  {
   "type": "LOW_FLOW_FALLBACK",
   "applies_to": "VELOCITY_MIN",
   "action": "flushing_device",
   "clause": "3.29",
   "text": "평탄해 자기세정 유속을 얻을 수 없으면 플러싱 장치"
  },
  {
   "type": "DESIGN_FLOW",
   "per_capita": {
    "param": "per_capita_wastewater",
    "cond": {
     "system": "separate",
     "facility": "conventional sewers"
    },
    "allow": [
     "facility"
    ]
   },
   "infiltration": {
    "kind": "excluded",
    "text": "Table 3.3 면적·연장·맨홀당 — 미포함"
   },
   "peak": {
    "kind": "table_by_population",
    "param": "peak_factor_hourly",
    "cond": {
     "system": "separate"
    }
   }
  },
  {
   "type": "PUMP_TRIGGER",
   "kind": "depth_limit",
   "param": "max_sewer_depth",
   "cond": {},
   "clause": "3.21 Table 3.15 note",
   "text": "매설 깊이 6 m 초과 시 중계펌프장(의무). 4.18 지하수 높음·암반 3 m 이상 유리(참고)는 미적용",
   "allow": [
    "exception"
   ],
   "resolution": "표 3.15 주: 6 m 한도(의무), 단서(방류관 등 정당화 시 더 깊게)는 설계자 검토"
  },
  {
   "type": "FORCE_MAIN_VELOCITY",
   "min_param": "force_main_min_velocity",
   "max_param": "force_main_max_velocity",
   "cond": {
    "pipe_role": "force_main"
   },
   "allow": [
    "pipe_role"
   ],
   "flow": "design_pumping_rate",
   "binding_filter": "mandatory",
   "resolution": "4.20.3 '언제나 0.8~3 m/s'(의무) 적용, 저유량 1.0·경험칙 2.7은 기준 단계라 표시만"
  },
  {
   "type": "FORCE_MAIN_FRICTION",
   "param": "hazen_williams_c",
   "cond": {
    "pipe_role": "force_main",
    "material": "pvc"
   },
   "allow": [
    "pipe_role"
   ],
   "pick": "min"
  },
  {
   "type": "PUMP_COUNT",
   "param": "pump_count_rule",
   "cond": {
    "other": {
     "station_size": "small"
    }
   },
   "allow": [
    "other"
   ],
   "kind": "dwf_multiples",
   "multiples": [
    1,
    2,
    3
   ],
   "text": "4.5.4 소규모 1·2·3 DWF(참고)"
  },
  {
   "type": "WET_WELL_VOLUME",
   "kind": "cycle_formula",
   "cycle_param": "pump_cycle_time",
   "clause": "4.6.6 V = T·Q/4"
  },
  {
   "type": "PUMP_HEAD_POWER",
   "efficiency": "project",
   "clause": "Table 4.3 효율표(구간 조건 미정리) — 사업값"
  },
  {
   "type": "WET_WELL_LEVEL",
   "kind": "below_inlet_invert",
   "param": "pump_operating_levels",
   "cond": {
    "item": "suction level below incoming invert"
   },
   "allow": [
    "item"
   ],
   "pick": "max",
   "resolution": "4.1.4 흡입수위는 유입관저 아래 0.5~1.0 m(기준) — 실양정을 크게 보는 1.0 m"
  },
  {
   "type": "MINOR_LOSS",
   "kind": "k_table",
   "param": "fitting_loss_coefficient",
   "cond": {
    "pipe_role": "force_main"
   },
   "allow": [
    "item",
    "pipe_role"
   ],
   "velocity_head": true,
   "clause": "4.7.2 전양정 = 정수두+속도수두+마찰수두 / 4.7.3 Table 4.2 K — 부속 구성은 펌프장별 입력, 없으면 판정 보류"
  },
  {
   "type": "SUCTION_PIPE",
   "kind": "review",
   "text": "흡입 유속 규정 없음(4.5.1 구 통과경 ≥80 mm는 펌프 사양)"
  },
  {
   "type": "PUMP_SUBMERGENCE_NPSH",
   "kind": "submergence_above_pump",
   "param": "pump_operating_levels",
   "cond": {
    "other": {
     "pump_type": "submersible"
    }
   },
   "allow": [
    "other"
   ],
   "npsh": "4.8 NPSHa > NPSHr — 펌프 NPSHr 입력 필요"
  },
  {
   "type": "HOUSE_CONNECTION",
   "kind": "review",
   "text": "3.70 맨홀에만 접속(본관 직접 접속 폐지), 접속 높이 수치 없음"
  },
  {
   "type": "DROP_STRUCTURE",
   "param": "drop_manhole_threshold",
   "boundary": "gt",
   "clause": "3.25",
   "pipe": {
    "kind": "same_as_inlet",
    "clause": "3.25"
   },
   "large": {
    "above_mm": 450,
    "text": "450 mm 초과 관은 계단·경사로·선행 맨홀 분할 낙차 등으로 처리(3.25)"
   },
   "allow": [
    "joint_method",
    "exception",
    "other"
   ]
  },
  {
   "type": "PLANT_FLOW",
   "flows": {
    "average": {
     "kind": "sewer_no_peak",
     "clause": "3장 1인 하수량 × 인구"
    },
    "peak_hourly": {
     "kind": "sewer_peak",
     "clause": "Table 3.2 첨두계수(관로와 같은 값, 처리장 첨두 정의 없음)"
    },
    "max_daily": {
     "kind": "none",
     "why": "처리 단위별 최대일유량 정의 없음"
    }
   }
  },
  {
   "type": "INFLUENT_LOAD",
   "bod": {
    "param": "influent_bod_per_capita",
    "cond": {
     "item": "BOD"
    }
   },
   "ss": {
    "param": "influent_ss_per_capita",
    "cond": {
     "item": "TSS"
    }
   },
   "concentration_flow": "average",
   "resolution": "5.1.4.1 Table 5.4 (생물학적 STP 설계에 이 표를 따른다)"
  },
  {
   "type": "PRIMARY_CLARIFIER",
   "loading": [
    {
     "param": "primary_surface_loading",
     "cond": {
      "settling_type": "followed_by_secondary_treatment",
      "flow_basis": "average"
     },
     "flow": "average"
    },
    {
     "param": "primary_surface_loading",
     "cond": {
      "settling_type": "followed_by_secondary_treatment",
      "flow_basis": "peak"
     },
     "flow": "peak_hourly"
    }
   ],
   "depth": {
    "param": "primary_side_water_depth",
    "cond": {
     "settling_type": "followed_by_secondary_treatment"
    }
   },
   "weir": [
    {
     "param": "primary_weir_loading",
     "cond": {
      "flow_basis": "average"
     },
     "flow": "average"
    }
   ],
   "count": [
    {
     "param": "primary_tank_count_min"
    }
   ],
   "bod_removal": {
    "param": "primary_bod_removal",
    "cond": {
     "use": "design"
    },
    "design": "max"
   },
   "ss_removal": {
    "param": "primary_ss_removal",
    "cond": {
     "use": "design"
    },
    "design": "max"
   },
   "resolution": "Table 5.8 이차처리 앞 일차침전지. 5.7.5 설계 제거율 BOD 최대 35%·SS 최대 60%(shall)"
  },
  {
   "type": "AERATION_TANK",
   "flow": "average",
   "hrt": {
    "param": "asp_hrt",
    "cond": {
     "process": "conventional_asp"
    }
   },
   "fm": {
    "param": "asp_fm_ratio",
    "cond": {
     "process": "conventional_asp"
    },
    "basis": "mlss"
   },
   "mlss": {
    "param": "asp_mlss",
    "cond": {
     "process": "conventional_asp"
    },
    "design": "mid"
   },
   "srt": {
    "param": "asp_srt",
    "cond": {
     "process": "conventional_asp"
    },
    "design": "mid"
   },
   "return": {
    "param": "asp_return_ratio",
    "cond": {
     "process": "conventional_asp"
    },
    "design": "mid"
   },
   "yield": {
    "param": "asp_yield",
    "cond": {
     "process": "activated_sludge_general"
    }
   },
   "decay": {
    "param": "asp_decay",
    "cond": {
     "process": "activated_sludge_general"
    }
   },
   "sludge": {
    "kind": "yobs_divisor",
    "divisor": {
     "param": "asp_sludge_production",
     "cond": {
      "process": "conventional_asp",
      "coefficient": "divisor_for_A",
      "item": "none"
     },
     "allow": [
      "item"
     ]
    }
   },
   "oxygen": {
    "kind": "per_bod_removed",
    "param": "asp_oxygen_requirement",
    "cond": {
     "process": "conventional_asp"
    },
    "design": "max"
   },
   "bod_removal": {
    "param": "asp_bod_removal",
    "cond": {
     "process": "conventional_asp"
    },
    "design": "min"
   },
   "ss_removal": {
    "source": "project",
    "key": "asp_ss_removal"
   },
   "resolution": "5.8.1.4 Table 5.9 재래식 행. 잉여슬러지 = Q·Yobs·(S0−S)/0.8 (5.8.1.7.5.10, 불활성 고형물 B는 수치 없어 제외). 산소량은 제거 BOD당 상한"
  },
  {
   "type": "SECONDARY_CLARIFIER",
   "loading": [
    {
     "param": "secondary_surface_loading",
     "cond": {
      "settling_type": "secondary_settling_for_activated_sludge",
      "flow_basis": "average"
     },
     "flow": "average"
    },
    {
     "param": "secondary_surface_loading",
     "cond": {
      "settling_type": "secondary_settling_for_activated_sludge",
      "flow_basis": "peak"
     },
     "flow": "peak_hourly"
    }
   ],
   "solids": [
    {
     "param": "secondary_solids_loading",
     "cond": {
      "settling_type": "secondary_settling_for_activated_sludge",
      "flow_basis": "average"
     },
     "flow": "average",
     "return": "design"
    },
    {
     "param": "secondary_solids_loading",
     "cond": {
      "settling_type": "secondary_settling_for_activated_sludge",
      "flow_basis": "peak"
     },
     "flow": "peak_hourly",
     "return": "design"
    }
   ],
   "depth": {
    "param": "secondary_side_water_depth"
   },
   "weir": [
    {
     "param": "secondary_weir_loading",
     "flow": "average"
    }
   ],
   "count": [
    {
     "param": "primary_tank_count_min"
    }
   ],
   "resolution": "Table 5.8 활성슬러지 이차침전지. 5.7.4.2.5 2기 이상은 일차·이차 공통"
  },
  {
   "type": "EFFLUENT_LIMIT",
   "country": "IN",
   "match_prefix": {
    "location": "all of India"
   },
   "params": {
    "bod": "^BOD$",
    "ss": "^TSS$"
   },
   "resolution": "최근 값: NGT O.A. 1069/2018 2019-04-30 명령(전국에 메트로 값 적용). 2017 고시 값은 시행 정지(2018-12-21)"
  }
 ],
 "pipe": {
  "nominal": "as_is",
  "min_dia_compare": "inner",
  "table_lookup": "nearest_inner"
 }
