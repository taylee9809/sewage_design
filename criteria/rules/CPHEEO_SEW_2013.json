    "horizon": "ultimate"
   },
   "flow": "design",
   "state": "actual",
   "resolution": "Table 3.9 + 3.15.5·부록 A 3.4"
  },
  {
   "type": "VELOCITY_MAX",
   "param": "max_velocity",
   "cond": {
    "system": "separate"
   },
   "state": "actual",
